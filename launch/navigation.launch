<launch>
  <arg name="map_file" default="$(env HOME)/maps/lab.yaml" />
  <arg name="open_rviz" default="true" />
  <arg name="scan_topic" default="/scan" />
  <arg name="cmd_vel_topic" default="/cmd_vel_mux/input/teleop" />

  <arg name="publish_base_footprint_to_base_link_tf" default="true" />
  <arg name="base_link_z" default="0.05" />

  <arg name="publish_base_link_to_laser_tf" default="false" />
  <arg name="laser_frame" default="laser" />
  <arg name="laser_x" default="0.0" />
  <arg name="laser_y" default="0.0" />
  <arg name="laser_z" default="0.28" />
  <arg name="laser_roll" default="0.0" />
  <arg name="laser_pitch" default="0.0" />
  <arg name="laser_yaw" default="0.0" />

  <include file="$(find lab_navigation)/launch/localization.launch">
    <arg name="map_file" value="$(arg map_file)" />
    <arg name="open_rviz" value="false" />
    <arg name="scan_topic" value="$(arg scan_topic)" />
    <arg name="publish_base_footprint_to_base_link_tf" value="$(arg publish_base_footprint_to_base_link_tf)" />
    <arg name="base_link_z" value="$(arg base_link_z)" />
    <arg name="publish_base_link_to_laser_tf" value="$(arg publish_base_link_to_laser_tf)" />
    <arg name="laser_frame" value="$(arg laser_frame)" />
    <arg name="laser_x" value="$(arg laser_x)" />
    <arg name="laser_y" value="$(arg laser_y)" />
    <arg name="laser_z" value="$(arg laser_z)" />
    <arg name="laser_roll" value="$(arg laser_roll)" />
    <arg name="laser_pitch" value="$(arg laser_pitch)" />
    <arg name="laser_yaw" value="$(arg laser_yaw)" />
  </include>

  <rosparam command="load" file="$(find lab_navigation)/config/costmap_common_params.yaml" ns="move_base/global_costmap" subst_value="true" />
  <rosparam command="load" file="$(find lab_navigation)/config/costmap_common_params.yaml" ns="move_base/local_costmap" subst_value="true" />
  <rosparam command="load" file="$(find lab_navigation)/config/global_costmap_params.yaml" ns="move_base/global_costmap" />
  <rosparam command="load" file="$(find lab_navigation)/config/local_costmap_params.yaml" ns="move_base/local_costmap" subst_value="true" />
  <rosparam command="load" file="$(find lab_navigation)/config/move_base_params.yaml" ns="move_base" />
  <rosparam command="load" file="$(find lab_navigation)/config/trajectory_local_planner_params.yaml" ns="move_base" />

  <node pkg="move_base"
        type="move_base"
        name="move_base"
        output="screen">
    <remap from="cmd_vel" to="$(arg cmd_vel_topic)" />
  </node>

  <node if="$(arg open_rviz)"
        pkg="rviz"
        type="rviz"
        name="rviz"
        args="-d $(find lab_navigation)/rviz/navigation.rviz" />
</launch>
