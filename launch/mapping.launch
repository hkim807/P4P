<launch>
  <arg name="open_rviz" default="true" />
  <arg name="use_depthimage_to_laserscan" default="false" />

  <arg name="scan_topic" default="/scan" />
  <arg name="depth_image_topic" default="/camera/depth/image_raw" />
  <arg name="depth_camera_info_topic" default="/camera/depth/camera_info" />
  <arg name="scan_frame" default="camera_depth_frame" />

  <node if="$(arg use_depthimage_to_laserscan)"
        pkg="depthimage_to_laserscan"
        type="depthimage_to_laserscan"
        name="depthimage_to_laserscan"
        output="screen">
    <remap from="image" to="$(arg depth_image_topic)" />
    <remap from="camera_info" to="$(arg depth_camera_info_topic)" />
    <remap from="scan" to="$(arg scan_topic)" />
    <param name="output_frame_id" value="$(arg scan_frame)" />
    <param name="scan_height" value="10" />
    <param name="range_min" value="0.45" />
    <param name="range_max" value="4.0" />
  </node>

  <node pkg="cartographer_ros"
        type="cartographer_node"
        name="cartographer_node"
        args="-configuration_directory $(find lab_navigation)/config -configuration_basename turtlebot2_2d.lua"
        output="screen">
    <remap from="scan" to="$(arg scan_topic)" />
  </node>

  <node pkg="cartographer_ros"
        type="cartographer_occupancy_grid_node"
        name="cartographer_occupancy_grid_node"
        args="-resolution 0.05 -publish_period_sec 1.0"
        output="screen" />

  <node if="$(arg open_rviz)"
        pkg="rviz"
        type="rviz"
        name="rviz"
        args="-d $(find lab_navigation)/rviz/mapping.rviz" />
</launch>
